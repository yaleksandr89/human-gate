{
    "name": "yaleksandr89/human-gate",
    "description": "Lightweight first-party CAPTCHA and anti-bot challenges for PHP.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/yaleksandr89/human-gate",
    "keywords": ["captcha", "anti-bot", "security", "challenge", "spam-protection"],
    "support": {
        "issues": "https://github.com/yaleksandr89/human-gate/issues",
        "source": "https://github.com/yaleksandr89/human-gate"
    },
    "require": {
        "php": "^8.4",
        "ext-gd": "*"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95.27",
        "phpstan/phpstan": "^2.2.16",
        "phpstan/phpstan-deprecation-rules": "^2.0.5",
        "phpunit/phpunit": "^13.3.5"
    },
    "autoload": {
        "psr-4": {
            "Yaleksandr\\HumanGate\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Yaleksandr\\HumanGate\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "coverage": [
            "@putenv XDEBUG_MODE=coverage",
            "phpunit --coverage-text --coverage-clover .build/coverage.xml"
        ],
        "analyse": "phpstan analyse",
        "cs:check": "php-cs-fixer check --diff",
        "cs:fix": "php-cs-fixer fix",
        "check": [
            "@composer validate --strict",
            "@composer audit",
            "@cs:check",
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true
    }
}

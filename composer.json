{
    "name": "yaleksandr89/human-gate",
    "description": "Lightweight first-party CAPTCHA and anti-bot challenges for PHP.",
    "homepage": "https://github.com/yaleksandr89/human-gate",
    "keywords": [
        "captcha",
        "anti-bot",
        "security",
        "challenge",
        "spam-protection"
    ],
    "authors": [
        {
            "name": "Александр Юрченко",
            "email": "y.aleksandr89@yandex.ru",
            "homepage": "https://github.com/yaleksandr89",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/yaleksandr89/human-gate/issues",
        "source": "https://github.com/yaleksandr89/human-gate",
        "forum": "https://github.com/yaleksandr89/human-gate/discussions",
        "security": "https://github.com/yaleksandr89/human-gate/security/policy"
    },
    "funding": [
        {
            "type": "other",
            "url": "https://boosty.to/backendbezpafosa"
        },
        {
            "type": "other",
            "url": "https://sponsr.ru/backendbezpafosa/"
        }
    ],
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "ext-gd": "*"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95.27",
        "phpstan/phpstan": "^2.2.16",
        "phpstan/phpstan-deprecation-rules": "^2.0.5",
        "phpunit/phpunit": "^13.3.5"
    },
    "autoload": {
        "psr-4": {
            "Yaleksandr\\HumanGate\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Yaleksandr\\HumanGate\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "coverage": [
            "@putenv XDEBUG_MODE=coverage",
            "phpunit --coverage-text --coverage-clover .build/coverage.xml"
        ],
        "analyse": "phpstan analyse",
        "cs:check": "php-cs-fixer check --diff",
        "cs:fix": "php-cs-fixer fix",
        "check": [
            "@composer validate --strict",
            "@composer audit",
            "@cs:check",
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true
    }
}
